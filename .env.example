# Copy this file to .env and adjust if you want something other than the
# defaults below - both are optional, mp3_parsing.py runs fine with no
# .env at all.

# Where converted .mp3 files are written. Relative paths are resolved
# against the project root. Default: "output" (i.e. ./output/).
OUTPUT_DIR=output

# ffmpeg libmp3lame VBR quality: 0 (best, ~220-260kbps) to 9 (worst,
# smallest file). Default: 0.
MP3_QUALITY=0
